# Application
APP_ENV=development
RELEASE_SHA=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://nusa_intel:nusa_intel_dev@localhost:5432/nusa_intel
CORS_ORIGINS=["http://localhost:3100"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3100
API_PORT=8000
DB_PORT=5432

# Local PostgreSQL only. Use a secret manager outside local development.
POSTGRES_DB=nusa_intel
POSTGRES_USER=nusa_intel
POSTGRES_PASSWORD=nusa_intel_dev

# Obtain a token from https://webapi.bps.go.id/developer/.
# Never commit a real key.
BPS_API_KEY=replace_with_your_bps_api_key
BPS_SCHEDULE_ENABLED=false
BPS_SCHEDULE_INDICATOR=tpt
BPS_SCHEDULE_INTERVAL_SECONDS=86400

# Grounded-answer operational guardrails.
REGULATION_ANSWER_TIMEOUT_SECONDS=9
REGULATION_MAXIMUM_CONCURRENT_ANSWERS=8
REGULATION_ANSWER_RATE_LIMIT_REQUESTS=10
REGULATION_ANSWER_RATE_LIMIT_WINDOW_SECONDS=60
