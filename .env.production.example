# Copy values into `.env.production` or a production secret manager; never commit it.
APP_ENV=production
LOG_LEVEL=INFO
IMAGE_TAG=CHANGE_ME_TO_GIT_COMMIT_SHA

# Use a unique 32+ character URL-safe password (letters, digits, `_`, `-`). The production
# Compose file derives DATABASE_URL from these fields so the database and app cannot drift.
POSTGRES_DB=nusa_intel
POSTGRES_USER=nusa_intel
POSTGRES_PASSWORD=CHANGE_ME_TO_A_URL_SAFE_RANDOM_VALUE

# Point both DNS names to the same public server before starting the proxy. Compose derives
# CORS_ORIGINS, ALLOWED_HOSTS, and the browser-visible API URL from these names.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# BPS scheduling is disabled until a secret key and intended cadence are configured.
BPS_API_KEY=
BPS_SCHEDULE_ENABLED=false
BPS_SCHEDULE_INDICATOR=tpt
BPS_SCHEDULE_INTERVAL_SECONDS=86400

# Per-process guardrails. Keep an edge rate limiter in front of every public deployment.
REGULATION_ANSWER_TIMEOUT_SECONDS=9
REGULATION_MAXIMUM_CONCURRENT_ANSWERS=8
REGULATION_ANSWER_RATE_LIMIT_REQUESTS=10
REGULATION_ANSWER_RATE_LIMIT_WINDOW_SECONDS=60
